{
  "name": "portfolio-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint .",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "generate:resume": "node scripts/generate-resume-formats.ts",
    "generate:resume:check": "node scripts/generate-resume-formats.ts --check",
    "generate:og": "node scripts/generate-og-image.ts",
    "generate:og:check": "node scripts/generate-og-image.ts --check",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.18.2",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@cloudflare/vite-plugin": "^1.54.7",
    "@oxlint/plugins": "1.86.0",
    "@rolldown/plugin-babel": "^0.2.3",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "fflate": "^0.8.3",
    "oxfmt": "^0.63.0",
    "oxlint": "1.86.0",
    "typescript": "~6.0.2",
    "vite": "^8.0.12",
    "wrangler": "^4.131.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20261001.1": true
  }
}
